# ==============================================================================
# NIVARA SUPERHERO PUBLIC PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# RESEND EMAIL CONFIGURATION (Server-side, official SDK)
# ------------------------------------------------------------------------------
# Get your Resend API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=Nivara <onboarding@resend.dev>
NOTIFICATION_EMAIL=your_project_email@example.com

# Candidate notification aliases
NIVARA_NOTIFICATION_EMAIL=your_project_email@example.com
RESEND_FROM_EMAIL=Nivara <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI CONFIGURATION (Server-side, secure)
# ------------------------------------------------------------------------------
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# EMAIL DISPATCH CONFIGURATION (Nodemailer SMTP Fallback - Optional)
# ------------------------------------------------------------------------------
EMAIL_USER=your_smtp_user@example.com
EMAIL_PASSWORD=your_smtp_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
